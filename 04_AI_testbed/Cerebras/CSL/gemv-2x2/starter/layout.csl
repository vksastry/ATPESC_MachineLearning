// total matrix dimensions
param M: i16;
param N: i16;

// Colors
const ax_color: color = @get_color(0); // sends/recvs partial result Ax EAST
const x_color:  color = @get_color(1); // sends/recvs elems x

// This example uses 2x2 PEs
const memcpy = @import_module("<memcpy/get_params>", .{
  .width = 2,
  .height = 2
});

layout {
  // PE coordinates are (column, row)
  @set_rectangle(2, 2);

  for (@range(i16, 2)) |pe_x| {
    for (@range(i16, 2)) |pe_y| {
      @set_tile_code(pe_x, pe_y, "pe_program.csl", .{
        .memcpy_params = memcpy.get_params(pe_x),
        .M_per_PE = M / 2,
        .N_per_PE = N / 2,
        .ax_color = ax_color,
        .x_color = x_color
      });
    }
  }

  // =========================================================================
  // EXERCISE: wire the 8 routes below. There are two colors:
  //   ax_color (id 0) -- REDUCE:    partial y flows EAST (left col -> right col)
  //   x_color  (id 1) -- BROADCAST: x flows SOUTH (top row -> bottom row)
  // For each route choose from RAMP, EAST, WEST, NORTH, SOUTH.
  // RAMP = into/out of this PE's own compute core. Compass = to a neighbor.
  // Fill in every .rx = .{ ??? } and .tx = .{ ??? }.
  // =========================================================================

  // ----- Top left PE (0, 0) : NW quadrant -----

  // EXERCISE: ax_color REDUCE, left column => this PE SENDS its partial y.
  // Its value leaves its own core (RAMP) and heads toward the EAST neighbor.
  @set_color_config(0, 0, ax_color, .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // EXERCISE: x_color BROADCAST, top row => this PE ORIGINATES x.
  // It streams x out of its core (RAMP), delivers a copy back to its own core,
  // AND forwards it to the SOUTH neighbor. (Two tx destinations.)
  @set_color_config(0, 0, x_color,  .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // ----- Top right PE (1, 0) : NE quadrant -----

  // EXERCISE: ax_color REDUCE, right column => this PE RECEIVES the partial y.
  // It arrives on the WEST link and drops into this PE's core (RAMP).
  @set_color_config(1, 0, ax_color, .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // EXERCISE: x_color BROADCAST, top row => this PE ORIGINATES its own x.
  // Same pattern as PE (0,0): out of core, copy to core, forward SOUTH.
  @set_color_config(1, 0, x_color,  .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // ----- Bottom left PE (0, 1) : SW quadrant -----

  // EXERCISE: ax_color REDUCE, left column => this PE SENDS its partial y EAST.
  // Same sender pattern as PE (0,0).
  @set_color_config(0, 1, ax_color, .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // EXERCISE: x_color BROADCAST, bottom row => this PE RECEIVES x.
  // The x wavelets arrive from the NORTH neighbor and drop into its core (RAMP).
  @set_color_config(0, 1, x_color,  .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // ----- Bottom right PE (1, 1) : SE quadrant -----

  // EXERCISE: ax_color REDUCE, right column => this PE RECEIVES the partial y.
  // Same receiver pattern as PE (1,0): from WEST into core.
  @set_color_config(1, 1, ax_color, .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // EXERCISE: x_color BROADCAST, bottom row => this PE RECEIVES x.
  // Same receiver pattern as PE (0,1): from NORTH into core.
  @set_color_config(1, 1, x_color,  .{.routes = .{ .rx = .{ ??? }, .tx = .{ ??? } }});

  // export symbol names
  @export_name("A", [*]f32, true);
  @export_name("x", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("compute", fn()void);
}
